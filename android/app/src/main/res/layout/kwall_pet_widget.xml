<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top & Main Area: Interactive Kitty Stage covering all remaining space -->
    <FrameLayout
        android:id="@+id/widget_cat_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_cat_stage_bg">

        <!-- Pixel art floor line near bottom of stage -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#15FFFFFF" />

        <!-- Interactive Cat Avatar Sprite (prominent, centered) -->
        <ImageView
            android:id="@+id/widget_cat_avatar"
            android:layout_width="104dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_pet_habits_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_cat" />

        <!-- Pixel Art Red 'X' Anger Mark (visible when annoyed) -->
        <ImageView
            android:id="@+id/widget_cat_anger_x"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp"
            android:layout_marginStart="36dp"
            android:contentDescription="@string/widget_pet_habits_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_anger_x"
            android:visibility="gone" />

        <!-- Affection Heart Mark (visible when happy) -->
        <ImageView
            android:id="@+id/widget_cat_heart"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp"
            android:layout_marginStart="36dp"
            android:contentDescription="@string/widget_pet_habits_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_heart"
            android:visibility="gone" />

        <!-- Brand label in top-right corner -->
        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="kwall"
            android:textColor="#558D9C8F"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Bottom Bar / Bottom Section: Pet Name, Level Chip, Task Indicator, and XP Bar -->
    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_bottom_bar_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Line 1: Pet Name + Level Chip on left, Task/Habits indicator on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="MISHI"
                android:textColor="#F1F3E9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pet_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_chip_accent"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="Nv. 1"
                android:textColor="#B2D39C"
                android:textSize="9sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_habit_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/widget_pet_habits_name"
                android:src="@drawable/ic_widget_check" />

            <TextView
                android:id="@+id/widget_habits_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="0 pendientes"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Line 2: XP progress bar and text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_pet_xp_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_bar" />

            <TextView
                android:id="@+id/widget_pet_xp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="0 / 100 XP"
                android:textColor="#8D9C8F"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
